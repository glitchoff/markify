---
import Base from "./Base.astro";
import { DOC_GROUPS, docIndex } from "../docs-config";
import { withBase } from "../base";

interface Props {
  slug: string;
  file: string;
  title: string;
}

const { slug, file, title } = Astro.props;

const index = docIndex(slug);
const flat = DOC_GROUPS.flatMap((g) => g.items);
const prev = index > 0 ? flat[index - 1] : null;
const next = index < flat.length - 1 ? flat[index + 1] : null;
---

<Base active="docs">
  <div class="flex w-full h-[calc(100dvh-140px)] overflow-hidden">
    <!-- Desktop sidebar (server-rendered) -->
    <aside class="hidden md:block">
      <div class="fixed top-20 left-4 max-h-[calc(100vh-6rem)] overflow-y-auto rounded-xl border border-border bg-card p-3 shadow-sm w-64 z-20 [scrollbar-width:thin]">
        <div class="mb-2 flex items-center justify-between border-b border-border pb-2">
          <span class="px-1 text-xs font-bold uppercase tracking-wider text-muted-foreground">Docs</span>
          <a href="/" class="rounded-md p-1 text-muted-foreground hover:bg-muted hover:text-foreground transition-colors" title="Back to demo">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5"/><path d="m12 19-7-7 7-7"/></svg>
          </a>
        </div>
        <nav class="flex flex-col gap-4">
          {DOC_GROUPS.map((group) => (
            <div>
              <div class="px-3 py-1.5 text-[10px] font-bold uppercase tracking-wider text-muted-foreground/70">
                {group.label}
              </div>
              <div class="flex flex-col gap-0.5">
                {group.items.map((doc) => (
                  <a
                    href={withBase(`/docs/${doc.id}`)}
                    class:list={[
                      "group flex items-center gap-2 rounded-md px-3 py-2 text-xs font-medium transition-colors text-left",
                      doc.id === slug
                        ? "bg-primary text-primary-foreground font-semibold shadow-xs"
                        : "text-muted-foreground hover:bg-muted hover:text-foreground",
                    ]}
                  >
                    <span class:list={["h-1.5 w-1.5 rounded-full shrink-0", doc.id === slug ? "bg-current" : "bg-transparent"]} />
                    <span class="flex-1 truncate">{doc.title}</span>
                  </a>
                ))}
              </div>
            </div>
          ))}
        </nav>
      </div>
    </aside>

    <!-- Content column: page chrome is server-rendered, markdown is a client island -->
    <div class="min-w-0 flex-1 md:pl-[17rem] overflow-hidden">
      <div class="mx-auto h-full w-full max-w-5xl overflow-y-auto px-4 md:w-[80%] md:px-0 md:pr-1 [scrollbar-width:thin] [scrollbar-color:var(--border)_transparent] [&::-webkit-scrollbar]:w-2 [&::-webkit-scrollbar-thumb]:rounded-full [&::-webkit-scrollbar-thumb]:bg-border [&::-webkit-scrollbar-track]:bg-transparent">
        <div class="mb-4 flex items-center justify-between gap-3 border-b border-border pb-3 pt-6 md:pt-0 text-xs text-muted-foreground">
          <span class="min-w-0 truncate font-mono">docs/{file}</span>
          <span class="text-[11px] shrink-0">Rendered with Markify</span>
        </div>

        <slot />

        <!-- Prev / Next pagination (server-rendered) -->
        <div class="mt-10 pt-4 border-t border-border flex items-center justify-between gap-4">
          {prev && (
            <a
              href={withBase(`/docs/${prev.id}`)}
              class="group flex-1 flex flex-col gap-0.5 rounded-lg border border-border bg-card px-4 py-3 transition-colors hover:border-primary/50 hover:bg-muted"
            >
              <span class="flex items-center gap-1 text-[10px] uppercase tracking-wide text-muted-foreground">
                ← Previous
              </span>
              <span class="text-sm font-medium text-foreground group-hover:text-primary transition-colors">{prev.title}</span>
            </a>
          ) || <span class="flex-1" />}
          {next && (
            <a
              href={withBase(`/docs/${next.id}`)}
              class="group flex-1 flex flex-col items-end gap-0.5 rounded-lg border border-border bg-card px-4 py-3 text-right transition-colors hover:border-primary/50 hover:bg-muted"
            >
              <span class="flex items-center gap-1 text-[10px] uppercase tracking-wide text-muted-foreground">
                Next →
              </span>
              <span class="text-sm font-medium text-foreground group-hover:text-primary transition-colors">{next.title}</span>
            </a>
          )}
        </div>
      </div>
    </div>
  </div>
</Base>
